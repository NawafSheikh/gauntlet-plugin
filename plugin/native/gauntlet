#!/bin/sh
# Gauntlet launcher for macOS and Linux (Windows runs gauntlet.exe, the same
# logic in Go). The agent builds are GitHub release files, so the plugin
# stays small: this makes sure the agent in Gauntlet's bin folder is at
# least the plugin's version, downloading it once if not and checking it
# against SHA256SUMS beside this file, then runs it with the same arguments.
#
# It never fails a hook: when the agent cannot be had it says why on stderr
# and exits 0, so the CLI goes on as if the plugin were not there.
dir=$(cd "$(dirname "$0")" && pwd)
say() { echo "gauntlet: $*" >&2; exit 0; }

case "$(uname -s)" in
  Darwin) os=darwin; conf="$HOME/Library/Application Support" ;;
  Linux) os=linux; conf="${XDG_CONFIG_HOME:-$HOME/.config}" ;;
  MINGW* | MSYS* | CYGWIN*) exec "$dir/gauntlet.exe" "$@" ;;
  *) say "no build for $(uname -s); see the plugin README" ;;
esac
case "$(uname -m)" in
  x86_64 | amd64) arch=amd64 ;;
  arm64 | aarch64) arch=arm64 ;;
  *) say "no build for $(uname -m) on $os; see the plugin README" ;;
esac

asset="gauntlet-agent-$os-$arch"
want=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$dir/../.claude-plugin/plugin.json" "$dir/../.codex-plugin/plugin.json" 2>/dev/null | head -n 1)
[ -n "$want" ] || say "no plugin version next to the launcher; reinstall the plugin"
sum=$(awk -v a="$asset" '$2 == a || $2 == "*" a { print tolower($1); exit }' "$dir/SHA256SUMS" 2>/dev/null)
[ -n "$sum" ] || say "no build for $os/$arch in this plugin"

if [ -n "$GAUNTLET_DATA_DIR" ]; then bindir="$(dirname "$GAUNTLET_DATA_DIR")/bin"; else bindir="$conf/Gauntlet/bin"; fi
bin="$bindir/gauntlet-agent"

# newer A B: true when version A is above version B (numeric, dotted).
newer() { awk -v a="$1" -v b="$2" 'BEGIN { split(a, x, "."); split(b, y, "."); for (i = 1; i <= 3; i++) { if (x[i] + 0 > y[i] + 0) exit 0; if (x[i] + 0 < y[i] + 0) exit 1 } exit 1 }'; }

have=""
if [ -x "$bin" ]; then
  # The note is "<version> <size>": a copy the agent made of itself since has another size.
  size=$(wc -c < "$bin" | tr -d ' ')
  have=$(awk -v s="$size" '$2 == s { print $1 }' "$bin.version" 2>/dev/null)
  [ -n "$have" ] || have=$("$bin" version 2>/dev/null)
fi

if [ -z "$have" ] || newer "$want" "$have"; then
  mkdir -p "$bindir" || say "cannot create $bindir"
  part="$bindir/.$asset.$$.part"
  url="${GAUNTLET_RELEASE_BASE:-https://github.com/NawafSheikh/gauntlet-plugin/releases/download}/v$want/$asset"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL --max-time 180 -o "$part" "$url"
  else
    wget -q -T 180 -O "$part" "$url"
  fi
  if [ $? -eq 0 ]; then
    got=$( (sha256sum "$part" 2>/dev/null || shasum -a 256 "$part") | awk '{ print tolower($1) }')
    if [ "$got" = "$sum" ]; then
      chmod 755 "$part" && mv -f "$part" "$bin" && echo "$want $(wc -c < "$bin" | tr -d ' ')" > "$bin.version"
      have="$want"
    else
      echo "gauntlet: downloaded agent does not match the plugin's SHA256SUMS" >&2
    fi
  else
    echo "gauntlet: could not download the agent $want from $url" >&2
  fi
  rm -f "$part"
  # An older agent still beats none; the next hook tries again.
  [ -x "$bin" ] || exit 0
fi
exec "$bin" "$@"
